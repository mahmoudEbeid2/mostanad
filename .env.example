# Example environment (non-secret settings only — never put real keys here).

# Certificates V2 — the time zone the `today` field source (and {{today}} in a
# template source) is formatted in: the calendar date where certificates are
# issued, not UTC. IANA name. Default: Africa/Cairo.
CERT_TZ=Africa/Cairo

# Certificates V2 renderer (Chromium) — memory on a small server.
# Close the browser after this many ms without a render; the next render
# relaunches it (~1–2 s). Default 300000 (5 min).
CERT_BROWSER_IDLE_MS=300000
# Pages per browser (renders in parallel per process). Default 1 in
# production, 2 elsewhere.
CERT_RENDER_PAGES=1
# BullMQ worker concurrency. Defaults: template 2, render 1, invoice 1.
CERT_TEMPLATE_CONCURRENCY=2
CERT_RENDER_CONCURRENCY=1
INVOICE_CONCURRENCY=1

# Certificates V2 renderer service (cert-renderer, the only process with Chromium).
# Callers (API, certificate template/render workers) reach it here; the
# renderer settings above (CERT_BROWSER_IDLE_MS, CERT_RENDER_PAGES) belong to it.
# Not 5060/5061: fetch() refuses those ports (SIP, on the Fetch "bad ports" list).
CERT_RENDERER_URL=http://localhost:5070
# Shared secret between the renderer and its callers (header X-Renderer-Token).
# Required in production — the service refuses to start without it. Generate
# one with `openssl rand -hex 32`; never commit the real value.
CERT_RENDERER_TOKEN=
# Client: whole-exchange timeout (queue wait + render) and retries on 503 busy.
CERT_RENDERER_TIMEOUT_MS=120000
CERT_RENDERER_BUSY_RETRIES=3
# Service: request size limit and how many requests may wait before 503 RENDERER_BUSY.
CERT_RENDERER_MAX_BYTES=52428800
CERT_RENDERER_MAX_PENDING=16
