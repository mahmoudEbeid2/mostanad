# Example environment (non-secret settings only — never put real keys here).

# Certificates V2 — the time zone the `today` field source (and {{today}} in a
# template source) is formatted in: the calendar date where certificates are
# issued, not UTC. IANA name. Default: Africa/Cairo.
CERT_TZ=Africa/Cairo

# Certificates V2 renderer (Chromium) — memory on a small server.
# Close the browser after this many ms without a render; the next render
# relaunches it (~1–2 s). Default 300000 (5 min).
CERT_BROWSER_IDLE_MS=300000
# Pages per browser (renders in parallel per process). Default 1 in
# production, 2 elsewhere.
CERT_RENDER_PAGES=1
# BullMQ worker concurrency. Defaults: template 2, render 1, invoice 1.
CERT_TEMPLATE_CONCURRENCY=2
CERT_RENDER_CONCURRENCY=1
INVOICE_CONCURRENCY=1
