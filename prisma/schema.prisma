datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. Internal Administration & RBAC
// ==========================================

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  username  String   @unique
  password  String
  phone     String?
  roleId    String?  @map("role_id")
  role      Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid())
  name      String
  slug      String           @unique
  module    String // e.g. "companies", "plans", "settings"
  roles     RolePermission[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ==========================================
// 2. Client Companies (Tenants)
// ==========================================
model Company {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  password  String
  email     String?  @unique
  phone     String?
  address   String?
  logoUrl   String?  @map("logo_url") // every migration already creates this column; schema.prisma didn't declare it, which is the drift task 1 (2026-09-13) found
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Scoped Relations
  products             Product[]
  images               CompanyImage[]
  subscriptions        Subscription[]
  templates            Template[]
  brands               Brand[]
  regulatoryDocuments  RegulatoryDocument[]
  referenceLabels      ReferenceLabel[]
  generatedLabels      GeneratedLabel[]
  certificateTypes     CertificateType[]
  certificateTemplates CertificateTemplate[]
  invoices             Invoice[]
  certificateBatches   CertificateBatch[]
  certificates         Certificate[]

  @@map("companies")
}

model CompanyImage {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String // e.g. "header_logo", "official_stamp", "signature_admin"
  imageUrl  String   @map("image_url") @db.Text // Can store URLs or inline Base64 data strings
  imageType String?  @map("image_type") // e.g. "stamp", "logo", "signature", "footer"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_images")
}

// ==========================================
// 3. Product Catalog
// ==========================================

model Category {
  id              String           @id @default(uuid())
  name            String           @unique
  products        Product[]
  referenceLabels ReferenceLabel[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id                 String   @id @default(uuid())
  name               String
  productCode        String?  @map("product_code")
  description        String?  @db.Text
  indications        String?  @db.Text
  targetSpecies      String[] @map("target_species") // Postgres native array type
  physicalForm       String?  @map("physical_form")
  appearance         String?
  activeIngredients  Json?    @map("active_ingredients") // e.g. [{"name": "L-Lysine", "concentration": "98.5%"}]
  dosage             String?  @db.Text
  mixingInstructions String?  @map("mixing_instructions") @db.Text
  withdrawalPeriod   String?  @map("withdrawal_period")
  contraindications  String?  @db.Text
  userSafety         String[] @map("user_safety") // Postgres native array type
  storage            String?  @db.Text
  packaging          String? // e.g. "25KG Bag", "1L Bottle"
  registrationNumber String?  @map("registration_number")
  origin             String?
  producer           String?
  specifications     Json? // stores { "type": "string", "values": { "pH": "...", "Assay": "..." } }

  // Label-engine fields (MOSTANAD_ARCHITECTURE.md §5.10) — nullable, backfilled by nothing,
  // populated going forward via the product form / label generation flow.
  routeOfAdmin       String? @map("route_of_admin")
  dosageForm         String? @map("dosage_form")
  strength           String?
  productType        String? @map("product_type")
  prescriptionStatus String? @map("prescription_status") // POM | OTC | VFD

  // Relations
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId    String?   @map("brand_id")
  brand      Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  companyId  String    @map("company_id")
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  generatedLabels GeneratedLabel[]
  invoiceItems    InvoiceItem[]
  certificates    Certificate[]

  @@map("products")
}

// ==========================================
// 4. Templates & Customization
// ==========================================

model Template {
  id          String   @id @default(uuid())
  name        String
  type        String
  brandId     String?  @map("brand_id")
  brand       Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  htmlContent String   @map("html_content") @db.Text
  fields      Json?
  isGlobal    Boolean  @default(true) @map("is_global")
  productId   String?  @map("product_id")
  companyId   String?  @map("company_id") // Null means system-wide default template
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  images TemplateImage[]

  @@map("templates")
}

model TemplateImage {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String // e.g. "background", "stamp_placeholder"
  imageUrl   String   @map("image_url") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("template_images")
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products             Product[]
  templates            Template[]
  referenceLabels      ReferenceLabel[]
  certificateTemplates CertificateTemplate[]
  invoices             Invoice[]

  @@map("brands")
}

// ==========================================
// 5. Plans & Subscriptions
// ==========================================

model Plan {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?        @db.Text
  price         Decimal        @db.Decimal(10, 2)
  interval      String // e.g., "month", "year"
  features      String[] // Postgres native array type
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId    String   @map("plan_id")
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate DateTime @default(now()) @map("start_date")
  endDate   DateTime @map("end_date")
  status    String // e.g. "active", "expired", "cancelled"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model BackgroundTask {
  id        String   @id @default(uuid())
  type      String // "catalog_upload" | "label_verification" | "certificate_generation"
  status    String // "pending" | "processing" | "completed" | "failed"
  result    Json? // Final JSON results output
  error     String? // Error message if failed
  companyId String?  @map("company_id")
  brandId   String?  @map("brand_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("background_tasks")
}

// ==========================================
// 8. EDA Requirements (Egyptian Drug Authority)
// ==========================================

// Was EdaRequirement / eda_requirements (Phase 3, §5.6). The TABLE was renamed
// (ALTER TABLE ... RENAME TO — no data loss, no column touched) but the two
// pre-existing columns keep their original unmapped physical names
// (extractedText/extractedData, not extracted_text/extracted_data as §5.6's
// own snippet shows) — renaming an EXISTING column is exactly what the
// additive-migration rule forbids. `title`/`authority`/`sourceType` are
// `String` (required) in §5.6 but nullable here for the same reason: adding a
// required column with no default to an existing table is not an additive
// migration. edaRequirementService.js is a thin shim over this model so
// existing callers (edaRequirementController.js) are unaffected.
model RegulatoryDocument {
  id String @id @default(uuid())

  title        String? // nullable — see file header
  authority    String? // "EDA" | "SFDA" | "MOHAP" — nullable, see file header
  country      String   @default("Egypt")
  productScope String[] @map("product_scope")

  sourceType       String?   @map("source_type") // official_upload|official_url|ai_web_search|manual — nullable, see file header
  sourceUrl        String?   @map("source_url")
  sourceIsOfficial Boolean   @default(false) @map("source_is_official")
  documentVersion  String?   @map("document_version")
  effectiveDate    DateTime? @map("effective_date")
  supersededById   String?   @map("superseded_by_id")
  retrievedAt      DateTime? @map("retrieved_at")
  documentHash     String?   @map("document_hash") // sha256 — dedup + change detection

  status           String    @default("pending_review") // pending_review|extracted|approved|rejected|superseded
  reviewedByUserId String?   @map("reviewed_by_user_id")
  reviewedAt       DateTime? @map("reviewed_at")

  // Coverage (§7.5)
  clauseTotal       Int?      @map("clause_total")
  clauseCovered     Int?      @map("clause_covered")
  coveragePercent   Float?    @map("coverage_percent")
  uncoveredClauses  Json?     @map("uncovered_clauses")
  coverageAuditedAt DateTime? @map("coverage_audited_at")

  // §0/§1 of the ingestion overhaul: activation is automatic — coverage below
  // threshold no longer blocks a document from becoming usable, it only caps
  // the severity of everything it contributes (full -> normal FAIL allowed,
  // partial -> ruleValidator ceilings every FAIL from this document to
  // NEEDS_REVIEW). Set once, at activation, alongside `status: "approved"`.
  activationMode String? @default("full") @map("activation_mode") // full|partial

  // §2's one-pass catalog (discriminants + fields discovered from THIS
  // document). Null for documents ingested before this column existed, or for
  // any document whose extraction produced no usable catalog — both are valid
  // states, not errors: such a document still contributes RegulatoryRule rows,
  // it just contributes nothing to buildLabelSchema's composed field list.
  labelFieldSchema Json? @map("label_field_schema")

  extractedText String? @db.Text // physical column name unchanged, see file header
  extractedData Json? // physical column name unchanged, see file header

  companyId String?          @map("company_id")
  company   Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rules     RegulatoryRule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([country, authority, status])
  @@map("regulatory_documents")
}

model RegulatoryRule {
  id         String             @id @default(uuid())
  documentId String             @map("document_id")
  document   RegulatoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  ruleKey  String // "EG.VET.TARGET_SPECIES.REQUIRED"
  ruleType String // required_field|forbidden_content|format|conditional|value_constraint|language_set|semantic
  severity String // error | warning | info

  targetPath  String? @map("target_path") // path in labelSchema
  appliesWhen Json?   @map("applies_when") // condition — null = always
  constraint  Json // the §7.3 DSL payload

  description String  @db.Text
  citation    String? @db.Text // verbatim quote from the source document
  // "pending_review"/"approved" are retained for backward-compat and for the
  // manual PATCH .../reject escape hatch, but the ingestion overhaul (§0/§1)
  // no longer requires per-rule human approval before a rule is usable — a
  // freshly compiled rule is created directly as "active". getApprovedRulesForCountry
  // (regulatoryDocumentService.js) treats "active" the same as legacy "approved".
  status      String  @default("active") // active|approved|pending_review|rejected
  autoFixable Boolean @default(false) @map("auto_fixable")

  // §7's self-correction — a rule that would otherwise FAIL is capped by
  // ruleValidator at NEEDS_REVIEW when the system has a documented reason not
  // to trust its own certainty (see ruleValidator.js's severityDowngradeReasons).
  confidence          Float?    @default(1) // the compiler's own per-rule extraction confidence, 0-1 (§7a)
  autoDowngraded      Boolean   @default(false) @map("auto_downgraded") // §7b: statistically downgraded
  downgradeReason     String?   @map("downgrade_reason") @db.Text
  downgradedAt        DateTime? @map("downgraded_at")
  observedFailureRate Float?    @map("observed_failure_rate")
  observedSampleSize  Int?      @map("observed_sample_size")

  outcomes RuleEvaluationOutcome[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([documentId, ruleKey])
  @@index([ruleType, severity, status])
  @@map("regulatory_rules")
}

// §7b — raw pass/fail outcomes per (rule, discriminant combination), so a
// rule that fails an abnormally high proportion of labels of a GIVEN
// combination (not just overall) can be identified and auto-downgraded. Never
// deleted/aggregated-away: this table IS the audit trail behind
// RegulatoryRule.observedFailureRate/observedSampleSize.
model RuleEvaluationOutcome {
  id     String         @id @default(uuid())
  ruleId String         @map("rule_id")
  rule   RegulatoryRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  labelId         String? @map("label_id") // no FK — outcomes must survive a label being deleted
  discriminantKey String  @map("discriminant_key") // deterministic serialization of the discriminants map active for this label, "" if none
  status          String // "pass" | "fail" (raw ruleValidator result, before any downgrade ceiling)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ruleId, discriminantKey])
  @@map("rule_evaluation_outcomes")
}

// ==========================================
// 9. Reference Labels (AI Style Guides)
// ==========================================

model ReferenceLabel {
  id                 String  @id @default(uuid())
  name               String
  fullText           String? @map("full_text") @db.Text
  extractedData      Json? // AI-structured insights (phrasing, layout, ingredients format)
  country            String?
  sourceType         String  @default("upload") @map("source_type") // "upload" | "manual"
  manualCategoryName String? @map("manual_category_name")

  // Optional Company & Brand ID (Null = Global Reference)
  companyId  String?   @map("company_id")
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandId    String?   @map("brand_id")
  brand      Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // §5.9 extension (Phase 7 — the promotion carousel). Deferred since Phase 0
  // (flagged there as "never built"); built now because promoteToReference
  // structurally needs it. All nullable/defaulted — additive over an existing
  // table with data. `embedding` (pgvector) is NOT added — same §16 volume
  // gate as Phase 4's retrieval layer; §5.12 lists it as its own optional
  // migration (item 9) for exactly this reason.
  activeIngredients     Json?    @map("active_ingredients") // a real column now — distinct from the legacy extractedData.active_ingredients JSON key, no collision (that key only ever lived inside the Json blob)
  targetSpecies         String[] @default([]) @map("target_species")
  dosageForm            String?  @map("dosage_form")
  routeOfAdministration String?  @map("route_of_administration")
  indicationTags        String[] @default([]) @map("indication_tags")
  strengthSummary       String?  @map("strength_summary")
  productType           String?  @map("product_type")
  isApproved            Boolean  @default(true) @map("is_approved")

  qualityWeight  Float   @default(0.7) @map("quality_weight")
  originLabelId  String? @map("origin_label_id")
  approvalId     String? @map("approval_id")
  fingerprint    String?
  supersededById String? @map("superseded_by_id")
  needsReview    Boolean @default(false) @map("needs_review")

  @@index([country, productType])
  @@index([fingerprint, companyId])
  @@map("reference_labels")
}

// ==========================================
// 10. Label Engine — Persistence Foundation (Phase 1, MOSTANAD_ARCHITECTURE.md §5.1-5.4)
// ==========================================

model GeneratedLabel {
  id String @id @default(uuid())

  companyId       String   @map("company_id")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId       String?  @map("product_id")
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdByUserId String?  @map("created_by_user_id")

  inputPayload   Json  @map("input_payload") // frozen snapshot of what the caller submitted
  productProfile Json? @map("product_profile") // reserved for Phase 4's ProductProfile — null until then

  labelData       Json   @map("label_data") // the current label content
  labelProvenance Json   @map("label_provenance") // path -> { tier, source, citation, modelId, promptHash, at } (§14.4)
  schemaVersion   String @map("schema_version") // e.g. "vet-label@1.0.0" until Phase 2's labelSchema lands

  country  String
  language String
  status   String @default("draft") // draft|validated|failed_validation|approved|revoked|archived

  referenceLabelIds String[] @map("reference_label_ids")
  regulatoryDocIds  String[] @map("regulatory_doc_ids")
  matchTier         String?  @map("match_tier")
  generationMeta    Json?    @map("generation_meta")

  riskScore             Int     @default(0) @map("risk_score")
  autonomyTier          String  @default("mandatory") @map("autonomy_tier")
  shadowRunId           String? @map("shadow_run_id")
  promotedToReferenceId String? @map("promoted_to_reference_id")

  currentVersion Int     @default(1) @map("current_version")
  needsReview    Boolean @default(false) @map("needs_review") // Phase 7, §12.5 — set true when a reference this label cites gets revoked

  // §14.5 Verification (uploaded labels)
  origin         String  @default("generated") // generated | extracted
  extractionMeta Json?   @map("extraction_meta")
  sourceFileRef  String? @map("source_file_ref")

  versions     LabelVersion[]
  validations  ValidationReport[]
  chatMessages LabelChatMessage[]
  approvals    LabelApproval[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId, createdAt])
  @@index([productId])
  @@map("generated_labels")
}

model LabelVersion {
  id      String         @id @default(uuid())
  labelId String         @map("label_id")
  label   GeneratedLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  versionNumber Int  @map("version_number")
  labelData     Json @map("label_data") // full frozen snapshot

  changeSource         String  @map("change_source") // ai_generation|ai_chat_edit|manual_edit|restore
  changedByUserId      String? @map("changed_by_user_id")
  changeSummary        String? @map("change_summary") @db.Text
  diff                 Json? // [{ path, op, before, after }]
  restoredFrom         Int?    @map("restored_from")
  overrideAcknowledged Boolean @default(false) @map("override_acknowledged")

  validationReportId String?  @map("validation_report_id")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([labelId, versionNumber])
  @@map("label_versions")
}

model ValidationReport {
  id            String         @id @default(uuid())
  labelId       String         @map("label_id")
  label         GeneratedLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  versionNumber Int            @map("version_number")

  passed       Boolean
  errorCount   Int     @default(0) @map("error_count")
  warningCount Int     @default(0) @map("warning_count")

  verdicts          Json // FieldVerdict[] — populated starting Phase 2
  auditorVerdicts   Json?  @map("auditor_verdicts")
  disagreementCount Int    @default(0) @map("disagreement_count")
  selfConsistency   Json?  @map("self_consistency")
  coveragePercent   Float? @map("coverage_percent")

  engineVersion String   @map("engine_version")
  rulesetIds    String[] @map("ruleset_ids")
  aiAssisted    Boolean  @default(false) @map("ai_assisted")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([labelId, versionNumber])
  @@map("validation_reports")
}

model LabelChatMessage {
  id      String         @id @default(uuid())
  labelId String         @map("label_id")
  label   GeneratedLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  role          String // user | assistant | system | tool
  content       String  @db.Text
  intent        String? // edit | question | explain_validation
  toolCalls     Json?   @map("tool_calls")
  proposedPatch Json?   @map("proposed_patch")
  appliedPatch  Json?   @map("applied_patch")
  resultVersion Int?    @map("result_version")
  conflicts     Json?
  userId        String? @map("user_id")
  tokenUsage    Json?   @map("token_usage")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([labelId, createdAt])
  @@map("label_chat_messages")
}

// ==========================================
// 11. Assurance — Golden Set (Phase 0.5, §5.11/§14.3)
// ==========================================

model GoldenEvalRun {
  id            String   @id @default(uuid())
  runAt         DateTime @default(now()) @map("run_at")
  engineVersion String   @map("engine_version")
  modelId       String?  @map("model_id")
  promptHash    String?  @map("prompt_hash")

  fieldAccuracy    Json    @map("field_accuracy") // { [fieldPath]: { exact, partial, wrong, notApplicable, accuracyPercent } }
  overallAccuracy  Float   @map("overall_accuracy")
  baselineAccuracy Float?  @map("baseline_accuracy") // previous run's overallAccuracy, null for the first run
  regressed        Boolean @default(false)
  blockedDeploy    Boolean @default(false) @map("blocked_deploy")

  caseCount     Int      @default(0) @map("case_count")
  failedCaseIds String[] @map("failed_case_ids") // golden/ case directory names that errored outright (not scored)

  @@index([runAt])
  @@map("golden_eval_runs")
}

// ==========================================
// 12. External Knowledge Cache — Tier 5 (Phase 4, §5.8/§8.2)
// ==========================================

model ExternalKnowledgeCache {
  id String @id @default(uuid())

  kind      String // ingredient_monograph|product_dossier|species_norm
  lookupKey String @map("lookup_key") // e.g. "amoxicillin_trihydrate|oral_powder|poultry"

  payload Json
  summary String? @db.Text

  sourceType            String   @map("source_type")
  sourceUrls            String[] @map("source_urls")
  sourceIsAuthoritative Boolean  @default(false) @map("source_is_authoritative")
  citations             Json? // [{ claim, url, quotedText }]

  confidence       String // high | medium | low
  status           String  @default("unreviewed") // unreviewed | approved | rejected
  reviewedByUserId String? @map("reviewed_by_user_id")

  retrievedAt DateTime  @map("retrieved_at")
  expiresAt   DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([kind, lookupKey])
  @@index([kind, status])
  @@map("external_knowledge_cache")
}

// ==========================================
// 13. Assurance — Adversarial Audit (Phase 5, §5.11/§14.1)
// ==========================================

model AuditDisagreement {
  id            String @id @default(uuid())
  labelId       String @map("label_id")
  versionNumber Int    @map("version_number")
  fieldPath     String @map("field_path")

  deterministicVerdict Json   @map("deterministic_verdict") // the FieldVerdict from validationEngine
  auditorVerdict       Json   @map("auditor_verdict") // the FieldVerdict-shaped opinion from the adversarial auditor
  auditorReasoning     String @map("auditor_reasoning") @db.Text

  resolution   String? // human_agreed_engine | human_agreed_auditor | new_rule_created
  becameRuleId String? @map("became_rule_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([labelId, versionNumber])
  @@map("audit_disagreements")
}

// ==========================================
// 14. Approval — the human signature (Phase 7, §5.5/§12)
// ==========================================

model LabelApproval {
  id      String         @id @default(uuid())
  labelId String         @map("label_id")
  label   GeneratedLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  approvedVersion    Int    @map("approved_version")
  labelSnapshot      Json   @map("label_snapshot") // full copy, not a pointer — see §12.1
  validationReportId String @map("validation_report_id")

  approvedByUserId String   @map("approved_by_user_id")
  approverName     String   @map("approver_name") // copied at signing time
  approverRole     String?  @map("approver_role")
  approvedAt       DateTime @default(now()) @map("approved_at")

  signedEstimatedFields     String[] @map("signed_estimated_fields")
  acknowledgedUnverifiable  String[] @map("acknowledged_unverifiable")
  riskScoreAtApproval       Int      @map("risk_score_at_approval")
  autonomyTier              String   @map("autonomy_tier")
  coveragePercentAtApproval Float?   @map("coverage_percent_at_approval")
  rulesetSnapshot           String[] @map("ruleset_snapshot")
  note                      String?  @db.Text

  secondApproverUserId String?   @map("second_approver_user_id")
  secondApprovedAt     DateTime? @map("second_approved_at")
  promotedReferenceId  String?   @map("promoted_reference_id")

  revokedAt        DateTime? @map("revoked_at")
  revokedByUserId  String?   @map("revoked_by_user_id")
  revocationReason String?   @map("revocation_reason") @db.Text

  @@index([labelId, approvedVersion])
  @@index([approvedByUserId, approvedAt])
  @@map("label_approvals")
}

// ==========================================
// 15. Shadow Mode (Phase 8, §5.11/§14.5)
// ==========================================

model ShadowComparison {
  id              String  @id @default(uuid())
  labelId         String? @map("label_id") // nullable — a shadow run may not correspond to a persisted label
  oldEngineResult Json    @map("old_engine_result")
  newEngineResult Json    @map("new_engine_result")

  fieldsDiffered  String[] @map("fields_differed")
  verdictDiffered Boolean  @map("verdict_differed")

  latencyDeltaMs Int?   @map("latency_delta_ms")
  costDelta      Float? @map("cost_delta")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("shadow_comparisons")
}

// ==========================================
// 16. Certificates V2 (CERTIFICATES_V2_PLAN.md §6) — additive only.
//     V1 Template/TemplateImage stay untouched. Nothing here cascades from
//     Company: a company that still owns certificate data cannot be deleted
//     by accident (onDelete: Restrict).
// ==========================================

model StoredFile {
  id           String   @id @default(uuid())
  companyId    String?  @map("company_id") // null only for system assets
  kind         String // template_source | template_sanitized | template_prepared | template_thumb | template_diff | invoice_source | certificate_html | certificate_pdf | batch_zip
  path         String // relative to uploads/, e.g. certificates/{companyId}/{uuid}.html
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  sha256       String
  originalName String?  @map("original_name")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId, kind])
  @@map("stored_files")
}

model CertificateType {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name        String // "Certificate of Analysis"
  code        String // "COA" — unique per company
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  templates    CertificateTemplate[]
  certificates Certificate[]

  @@unique([companyId, code])
  @@map("certificate_types")
}

model CertificateTemplate {
  id                String          @id @default(uuid())
  companyId         String          @map("company_id")
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  certificateTypeId String          @map("certificate_type_id")
  certificateType   CertificateType @relation(fields: [certificateTypeId], references: [id], onDelete: Restrict)
  brandId           String?         @map("brand_id")
  brand             Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  country           String? // ISO-3166 alpha-2, e.g. "SA", "EG"
  scope             String          @default("per_product") // per_product | per_invoice
  name              String
  activeVersionId   String?         @unique @map("active_version_id")
  archivedAt        DateTime?       @map("archived_at")
  createdByUserId   String?         @map("created_by_user_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  versions TemplateVersion[]

  // + partial unique index on the template slot (raw SQL in the migration):
  //   UNIQUE (company_id, certificate_type_id, coalesce(brand_id,''), coalesce(country,''), scope) WHERE archived_at IS NULL
  @@index([companyId, certificateTypeId])
  @@map("certificate_templates")
}

model TemplateVersion {
  id               String              @id @default(uuid())
  templateId       String              @map("template_id")
  template         CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  versionNumber    Int                 @map("version_number")
  status           String              @default("uploaded") // uploaded|converting|draft|preparing|ready|active|superseded|failed
  sourceFormat     String              @map("source_format") // ai | pdf | html
  sourceFileId     String              @map("source_file_id")
  sanitizedFileId  String?             @map("sanitized_file_id") // converted + sanitized, fields NOT cleared (kept forever)
  preparedFileId   String?             @map("prepared_file_id") // fields cleared → what generation renders
  thumbnailFileId  String?             @map("thumbnail_file_id")
  pages            Json? // [{ page, widthPx, heightPx, widthPt, heightPt }]
  lines            Json? // [{ id, page, text, box:{x,y,w,h}, fontClass }]
  fontCoverage     Json?               @map("font_coverage") // { "ff1": "ACDEF…" }
  conversion       Json? // { tool, version, zoom, ms, warnings[] }
  prepareReport    Json?               @map("prepare_report") // §7.6 gate results
  error            String?
  basedOnVersionId String?             @map("based_on_version_id")
  createdByUserId  String?             @map("created_by_user_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  fields       TemplateField[]
  certificates Certificate[]

  @@unique([templateId, versionNumber])
  @@map("template_versions")
}

model TemplateField {
  id            String          @id @default(uuid())
  versionId     String          @map("version_id")
  version       TemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  key           String // snake_case, unique per version: "batch_no"
  label         String // "Batch number"
  page          Int             @default(1)
  lineId        String          @map("line_id") // data-line id assigned at sanitize
  origin        String          @default("manual") // manual | detected | ai_suggested (D10)
  confirmed     Boolean         @default(true) // activation refused while any field is unconfirmed (D10)
  charStart     Int             @map("char_start") // offsets in the line's textContent (sanitized HTML)
  charEnd       Int             @map("char_end")
  sampleValue   String          @map("sample_value") // exact original text — previews + round-trip gate
  source        Json // §10.3 — { kind, path?, text?, template? }
  format        Json? // { date?, case?, number?, prefix?, suffix? }
  required      Boolean         @default(true)
  align         String          @default("left") // left | center | right
  // geometry & calibration, written by prepare (§7.3):
  box           Json? // { x, y, w, h } CSS px, page-relative
  limits        Json? // { minX, maxX }
  letterSpacing Float?          @map("letter_spacing")
  fontClass     String?         @map("font_class")
  scale         Float?
  groupKey      String?         @map("group_key") // repeating group (Phase 7)
  sortOrder     Int             @default(0) @map("sort_order")

  @@unique([versionId, key])
  @@map("template_fields")
}

// ---------- Certificates V2 — invoices (CERTIFICATES_V2_PLAN.md §6.1, §9) ----------
model Invoice {
  id               String    @id @default(uuid())
  companyId        String    @map("company_id")
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  brandId          String?   @map("brand_id") // optional hint chosen at upload
  brand            Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  country          String? // chosen at upload, else extracted destination (A4)
  status           String    @default("uploaded") // uploaded|extracting|review|ready|generating|generated|partially_failed|failed
  sourceFileId     String    @map("source_file_id")
  header           Json? // reviewed header (what generation uses)
  headerExtracted  Json?     @map("header_extracted") // raw AI output, never edited (audit)
  extraction       Json? // { modelId, promptHash, ms, warnings[] }
  error            String?
  reviewedAt       DateTime? @map("reviewed_at")
  reviewedByUserId String?   @map("reviewed_by_user_id")
  uploadedByUserId String?   @map("uploaded_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  items        InvoiceItem[]
  batches      CertificateBatch[]
  certificates Certificate[]

  @@index([companyId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String   @map("invoice_id")
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lineNo          Int      @map("line_no")
  data            Json // reviewed: { name, code, batchNo, productionDate, expiryDate, quantity, unit, packing, extra }
  dataExtracted   Json     @map("data_extracted") // raw AI output (audit); {} for lines added by hand
  productId       String?  @map("product_id")
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  matchStatus     String   @default("needs_match") @map("match_status") // matched | needs_match | ignored
  matchMethod     String?  @map("match_method") // exact_code | exact_name | user
  matchCandidates Json?    @map("match_candidates") // [{ productId, name, code, score, reasons[] }]

  certificateItems CertificateItem[]

  @@unique([invoiceId, lineNo])
  @@map("invoice_items")
}

// ---------- Certificates V2 — generation (CERTIFICATES_V2_PLAN.md §6.1, §10) ----------
// Certificates and versions are never cascade-deleted (§6.1).
model CertificateBatch {
  id              String    @id @default(uuid())
  companyId       String    @map("company_id")
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoiceId       String    @map("invoice_id")
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  status          String    @default("queued") // queued|running|done|partially_failed|failed
  plan            Json // templateSelector output, frozen
  counts          Json? // { planned, rendered, failed, flagged }
  zipFileId       String?   @map("zip_file_id")
  startedByUserId String?   @map("started_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") // last progress — the stuck-batch cutoff (review #5)
  finishedAt      DateTime? @map("finished_at")

  certificates Certificate[]

  @@index([companyId, invoiceId])
  @@map("certificate_batches")
}

model Certificate {
  id                String           @id @default(uuid())
  companyId         String           @map("company_id")
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  batchId           String           @map("batch_id")
  batch             CertificateBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  invoiceId         String           @map("invoice_id")
  invoice           Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  templateVersionId String           @map("template_version_id") // exact design used → reproducible forever
  templateVersion   TemplateVersion  @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  certificateTypeId String           @map("certificate_type_id")
  certificateType   CertificateType  @relation(fields: [certificateTypeId], references: [id], onDelete: Restrict)
  scope             String // copied from the template at generation
  productId         String?          @map("product_id") // per_product only
  product           Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  planKey           String           @map("plan_key") // plan §20 I15: "{versionId}:{invoiceItemId}" | "{versionId}:invoice"
  status            String           @default("pending") // pending | draft | final | failed (pending: plan §20 I18)
  currentVersion    Int              @default(0) @map("current_version") // 0 until version 1 is rendered
  flagCount         Int              @default(0) @map("flag_count") // blocking flags, denormalised for badges
  search            String? // "productName batchNo invoiceNo", lower-case
  error             String?
  finalizedAt       DateTime?        @map("finalized_at")
  finalizedByUserId String?          @map("finalized_by_user_id")
  finalPdfFileId    String?          @map("final_pdf_file_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  items    CertificateItem[]
  versions CertificateVersion[]

  @@unique([batchId, planKey])
  @@index([companyId, invoiceId])
  @@index([companyId, status])
  @@map("certificates")
}

model CertificateItem {
  certificateId String      @map("certificate_id")
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  invoiceItemId String      @map("invoice_item_id")
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)
  position      Int

  @@id([certificateId, invoiceItemId])
  @@map("certificate_items")
}

model CertificateVersion {
  id              String      @id @default(uuid())
  certificateId   String      @map("certificate_id")
  certificate     Certificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  versionNumber   Int         @map("version_number")
  values          Json // { [fieldKey]: { value, source, resolved, origin, flags, editedByUserId, editedAt } } (§10.4)
  htmlFileId      String?     @map("html_file_id") // rendered static HTML (D9)
  pdfFileId       String?     @map("pdf_file_id") // created on export; frozen on finalize
  thumbnailFileId String?     @map("thumbnail_file_id") // page-1 PNG for cards (plan §20 I18)
  changeSource    String      @map("change_source") // generation | user_edit | restore | regenerate_field
  changedByUserId String?     @map("changed_by_user_id")
  changeSummary   String?     @map("change_summary")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@unique([certificateId, versionNumber])
  @@map("certificate_versions")
}
